// Modèle de quiz PerckyLingua, basé sur le quiz fourni « La cucina e il cibo ».
// L’import accepte les commentaires JSONC commençant par // ou entourés par /* ... */.
//
// Champs du quiz : title (obligatoire), category (facultative; Autre par défaut), description (facultative), questions (obligatoire).
// duration_minutes est conservé pour compatibilité; le temps réel est la somme des time_limit_seconds.
//
// Types de question :
// - qcm : options (tableau de choix) et correct_answer (texte exact du bon choix).
// - text : 
//   1. MONO-TROU & VARIANTES : 
//      correct_answer (mot, expression ou phrase attendue). Vous pouvez déclarer plusieurs variantes 
//      acceptées en les séparant par un slash '/' (ex: "cuocio / io cuocio"). 
//      La correction valide dès que l’élève saisit l’une des variantes (insensible à la casse et aux espaces).
//   2. MULTI-TROUS & NOTATION PARTIELLE (ex: conjuguer plusieurs verbes à la fois) :
//      - Barème par défaut : 1 point par trou (ex: une question avec 4 trous vaut automatiquement 4 points).
//      - Notation partielle : L'élève obtient des points pour chaque trou correct (ex: 3 trous corrects sur 4 = 3 points).
//      - Syntaxe : Utilisez le champ "answers" (tableau de chaînes) ou séparez les réponses de chaque trou par un pipe '|' 
//        dans "correct_answer" (ex: "parlo | scrivi | legge | dormiamo").
//        Vous pouvez autoriser des variantes par trou avec un slash '/' (ex: "parlo / io parlo").
// - reorder : items (au moins deux éléments DISTINCTS, déjà rangés dans l’ordre correct).
//   L’application mélange ces éléments pour l’élève; la correction vérifie la séquence exacte.
//
// - verbes_trous : exercice « Verbes à trous avec banque ».
//   - question : titre affiché pour la question.
//   - points : 3 points par phrase (1 point pour le choix du verbe + 2 points pour la conjugaison).
//   - verbes_trous.titre et verbes_trous.consigne : titre et consigne de l’exercice.
//   - verbes_trous.points_par_phrase : toujours 3.
//   - verbes_trous.banque : liste de verbes sans doublon; elle contient au moins autant de verbes que de phrases.
//   - verbes_trous.phrases : tableau des phrases; chaque élément contient id, debut, fin, verbe et reponses.
//   - verbe : infinitif attendu, présent une seule fois dans la banque et différent pour chaque phrase.
//   - reponses : tableau d’une ou plusieurs conjugaisons acceptées. La casse et les espaces superflus sont ignorés; les accents restent significatifs.
//   - Les verbes supplémentaires de la banque servent de pièges et ne rapportent aucun point.
//   Exemple de question :
//   {
//     "type": "verbes_trous",
//     "question": "Presente indicativo – completa le frasi",
//     "points": 6,
//     "verbes_trous": {
//       "titre": "Presente indicativo",
//       "consigne": "Scegli un verbo dalla banca, poi scrivi la forma corretta.",
//       "points_par_phrase": 3,
//       "banque": ["parlare", "leggere", "dormire", "scrivere"],
//       "phrases": [
//         { "id": 1, "debut": "Io ", "fin": " italiano.", "verbe": "parlare", "reponses": ["parlo", "io parlo"] },
//         { "id": 2, "debut": "Noi ", "fin": " un libro.", "verbe": "leggere", "reponses": ["leggiamo"] }
//       ]
//     }
//   }
//   - Le nombre de points de la question doit être égal à 3 × le nombre de phrases.
//
// time_limit_seconds est facultatif : valeur par défaut 17 s pour qcm/reorder, 32 s pour text.
// points détermine le barème; explanation (facultative) est montrée dans la correction.
// Les commentaires sont ignorés par l’importateur et ne modifient pas les données du quiz.

{
  "title": "La cucina e il cibo",
  "description": "Test sul vocabolario, il presente indicativo, l'accento tonico e la comprensione della ricetta del ragù alla bolognese",
  "category": "Vocabulaire",
  // Valeur indicative historique; le temps total est recalculé à partir des questions.
  "duration_minutes": 8,
  // Chaque question peut définir son propre time_limit_seconds.
  "questions": [
    {
      "type": "qcm",
      "question": "Come si dice \"la casserole\" in italiano?",
      "options": [
        "La padella",
        "La pentola",
        "La ciotola",
        "Il coperchio"
      ],
      "correct_answer": "La pentola",
      "points": 1,
      "explanation": "La pentola est la casserole. La padella est la poêle.",
      "time_limit_seconds": 17
    },
    {
      "type": "text",
      "question": "Qual è il verbo italiano (all'infinito) che significa \"éplucher\"?",
      "correct_answer": "Sbucciare",
      "points": 1,
      "explanation": "Sbucciare significa togliere la buccia, per esempio alle patate.",
      "time_limit_seconds": 32
    },
    {
      "type": "qcm",
      "question": "Che cosa significa \"q.b.\" in una ricetta italiana?",
      "options": [
        "Quanto basta",
        "Quasi bollito",
        "Quattro bicchieri",
        "Qualche bacca"
      ],
      "correct_answer": "Quanto basta",
      "points": 1,
      "explanation": "q.b. = quanto basta, cioè \"selon besoin\". Esempio: Sale q.b.",
      "time_limit_seconds": 17
    },
    {
      "type": "qcm",
      "question": "Come si dice \"le bœuf\" in italiano?",
      "options": [
        "Il maiale",
        "Il pollo",
        "Il manzo",
        "Il pesce"
      ],
      "correct_answer": "Il manzo",
      "points": 1,
      "explanation": "Il manzo è le bœuf. Il maiale è le porc, il pollo è le poulet e il pesce è le poisson.",
      "time_limit_seconds": 17
    },
    {
      "type": "text",
      "question": "Completa con il presente indicativo (noi) del verbo \"cuocere\": \"Noi ______ la pasta al dente.\"",
      // Astuce : séparez plusieurs réponses valides par '/' (ex: "Cuociamo / noi cuociamo")
      "correct_answer": "Cuociamo / noi cuociamo",
      "points": 1,
      "explanation": "Il presente di cuocere con \"noi\" è cuociamo (nous faisons cuire).",
      "time_limit_seconds": 32
    },
    {
      // EXEMPLE DE QUESTION MULTI-TROUS & BARÈME PAR DÉFAUT (1 pt par trou) :
      // Cette question comporte 4 trous. Par défaut, son barème est de 4 points (1 pt par trou).
      // Si l'élève réussit 3 trous sur 4, il obtiendra 3 points (notation partielle).
      "type": "text",
      "question": "Coniuga i verbi al presente: Io ______ (parlare), tu ______ (scrivere), lui ______ (leggere), noi ______ (dormire).",
      // Option A : Utiliser le champ "answers" avec un tableau de réponses pour chaque trou (avec variantes possibles via '/')
      "answers": [
        "parlo / io parlo",
        "scrivi / tu scrivi",
        "legge / lui legge",
        "dormiamo / noi dormiamo"
      ],
      // Option B (alternative) : "correct_answer": "parlo | scrivi | legge | dormiamo"
      "correct_answer": "parlo | scrivi | legge | dormiamo",
      "points": 4, // 4 trous = 4 points par défaut (1 point par trou)
      "explanation": "Conjugaison correcte des quatre verbes aux personnes correspondantes.",
      "time_limit_seconds": 45
    },
    {
      "type": "qcm",
      "question": "Secondo la ricetta, per quanto tempo cuoce il ragù lentamente?",
      "options": [
        "Per cinque minuti",
        "Per circa dieci minuti",
        "Per almeno due ore",
        "Per tutta la notte"
      ],
      "correct_answer": "Per almeno due ore",
      "points": 1,
      "explanation": "Nella ricetta: \"Lascia cuocere il ragù lentamente per almeno due ore.\"",
      "time_limit_seconds": 17
    },
    {
      "type": "qcm",
      "question": "Quando si aggiunge il latte nella ricetta del ragù?",
      "options": [
        "All'inizio, insieme all'olio",
        "Dopo il soffritto",
        "Verso la fine della cottura",
        "Quando si serve la pasta"
      ],
      "correct_answer": "Verso la fine della cottura",
      "points": 1,
      "explanation": "Il latte si aggiunge verso la fine, poi si continua la cottura per altri 10–15 minuti.",
      "time_limit_seconds": 17
    },
    {
      // Les items sont écrits dans l’ordre attendu; l’ordre affiché à l’élève sera mélangé.
      "type": "reorder",
      "question": "Qual è l'ordine corretto delle azioni?",
      "points": 1,
      "explanation": "Prima si prepara e si cuoce, alla fine si serve.",
      "time_limit_seconds": 17,
      "items": [
        "Tagliamo la cipolla",
        "Scaldiamo l'olio",
        "Aggiungiamo la cipolla",
        "Aggiungiamo i pomodori",
        "Serviamo la pasta"
      ]
    },
    {
      "type": "qcm",
      "question": "Come si dice \"l'oignon\" in italiano?",
      "options": [
        "L'aglio",
        "Il sedano",
        "La cipolla",
        "La carota"
      ],
      "correct_answer": "La cipolla",
      "points": 1,
      "explanation": "La cipolla est l'oignon. L'aglio est l'ail, il sedano le céleri, et la carota la carotte.",
      "time_limit_seconds": 17
    }
  ]
}
